{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xcassetsforge",
  "compatibility_date": "2025-08-01",

  // Everything runs in the browser — the Worker only serves the static bundle,
  // so no image ever leaves the user's machine.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // A route rather than a Custom Domain. The zone carries a `*.famio.dev/*`
  // route pointing at the `famio-dev` Worker, and it matches this hostname as
  // well; a Custom Domain was tried first and lost to it, serving the wrong
  // site. A more specific route wins over a wildcard, which this relies on.
  //
  // A route brings no DNS of its own, so the hostname resolves only because
  // the zone holds a proxied `AAAA 100::` record for it. That record is
  // maintained by hand; removing it takes the site down.
  "routes": [
    { "pattern": "xcassets.famio.dev/*", "zone_name": "famio.dev" }
  ]
}
